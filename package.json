{
  "name": "telegram-course-application-bot",
  "version": "1.0.0",
  "description": "Telegram bot for collecting course applications with PostgreSQL, Prisma, Excel reports and admin API.",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "npm run admin:build && tsc",
    "typecheck": "tsc --noEmit && npm run admin:typecheck",
    "backend:typecheck": "tsc --noEmit",
    "backend:build": "tsc",
    "dev": "nodemon --watch src --watch docs --ext ts --exec ts-node src/app.ts",
    "admin:dev": "vite --config admin/vite.config.ts --host 0.0.0.0",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:typecheck": "tsc -p admin/tsconfig.json --noEmit",
    "start": "node dist/src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "lucide-react": "^1.17.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "prisma": "^5.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.6.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.41",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^5.4.21"
  }
}
